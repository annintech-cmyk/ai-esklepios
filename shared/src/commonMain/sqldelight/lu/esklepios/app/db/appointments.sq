CREATE TABLE IF NOT EXISTS appointmentEntity (
    id TEXT NOT NULL PRIMARY KEY,
    practitionerId TEXT NOT NULL,
    practitionerName TEXT NOT NULL,
    clinicName TEXT NOT NULL,
    specialty TEXT NOT NULL,
    dateTime TEXT NOT NULL,
    status TEXT NOT NULL,
    messageToDoctor TEXT NOT NULL DEFAULT '',
    consultationReason TEXT NOT NULL DEFAULT ''
);

selectAll:
SELECT * FROM appointmentEntity;

selectById:
SELECT * FROM appointmentEntity WHERE id = ?;

selectByStatus:
SELECT * FROM appointmentEntity WHERE status = ?;

selectUpcoming:
SELECT * FROM appointmentEntity WHERE status IN ('PENDING', 'CONFIRMED') ORDER BY dateTime ASC;

selectPast:
SELECT * FROM appointmentEntity WHERE status IN ('COMPLETED', 'CANCELLED', 'NO_SHOW') ORDER BY dateTime DESC;

insertOrReplace:
INSERT OR REPLACE INTO appointmentEntity VALUES (?,?,?,?,?,?,?,?,?);

updateStatus:
UPDATE appointmentEntity SET status = ? WHERE id = ?;

deleteById:
DELETE FROM appointmentEntity WHERE id = ?;

deleteAll:
DELETE FROM appointmentEntity;
