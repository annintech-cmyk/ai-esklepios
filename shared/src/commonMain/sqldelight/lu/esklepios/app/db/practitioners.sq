CREATE TABLE IF NOT EXISTS practitionerEntity (
    id TEXT NOT NULL PRIMARY KEY,
    firstName TEXT NOT NULL,
    lastName TEXT NOT NULL,
    specialty TEXT NOT NULL,
    clinicName TEXT NOT NULL,
    address TEXT NOT NULL,
    city TEXT NOT NULL,
    phone TEXT NOT NULL,
    email TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    acceptingNewPatients INTEGER NOT NULL DEFAULT 0,
    availableSlotsJson TEXT NOT NULL DEFAULT '[]',
    scheduleJson TEXT NOT NULL DEFAULT '[]',
    paymentMethodsJson TEXT NOT NULL DEFAULT '[]',
    diplomasJson TEXT NOT NULL DEFAULT '[]',
    isFavorite INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM practitionerEntity;

selectById:
SELECT * FROM practitionerEntity WHERE id = ?;

selectFavorites:
SELECT * FROM practitionerEntity WHERE isFavorite = 1;

insertOrReplace:
INSERT OR REPLACE INTO practitionerEntity VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?);

updateFavorite:
UPDATE practitionerEntity SET isFavorite = ? WHERE id = ?;

deleteById:
DELETE FROM practitionerEntity WHERE id = ?;

deleteAll:
DELETE FROM practitionerEntity;
