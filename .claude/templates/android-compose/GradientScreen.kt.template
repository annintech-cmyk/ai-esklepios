/**
 * {{NAME}}Screen — {{DESCRIPTION}}
 *
 * Archetype: GRADIENT HERO (dashboard, feed, profile, detail screens).
 * Pattern: outer `Column { AppGradientHeader(...); <scrollable body> }`.
 *
 * `AppGradientHeader` supports several hero flavours via its parameters:
 *   • Toolbar-only       — leading/center/trailing actions
 *   • Search hero        — `search = HeaderSearch(...)`           (see HomeScreen.kt)
 *   • Centered profile   — `profile = HeaderProfile.Centered(...)`  (see ProfileScreen.kt)
 *   • Inline profile     — `profile = HeaderProfile.Inline(...)`    (see PractitionerDetailScreen.kt)
 *   • Overline + title   — `textBlock = HeaderTextBlock(overline, title)`
 *
 * The body below the header is responsible for rendering loading / error /
 * content states (the hero stays mounted regardless).
 */
@Composable
fun {{NAME}}Screen(
    navController: NavController,
    viewModel: {{NAME}}ViewModel = koinViewModel()
) {
    val uiState by viewModel.uiState.collectAsStateWithLifecycle()

    LaunchedEffect(Unit) {
        viewModel.load()
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Background)
    ) {
        AppGradientHeader(
            roundedBottom = true,
            leadingAction = HeaderAction.IconButtonAction(
                icon = Icons.Filled.ArrowBack,
                contentDescription = stringResource(R.string.cd_back),
                onClick = { navController.popBackStack() }
            ),
            centerAction = HeaderAction.TitleAction(
                text = stringResource(R.string.screen_{{name_snake}}),
                style = MaterialTheme.typography.headlineMedium
            )
            // ── Optional hero flavours — pick ONE and uncomment ───────────────
            // search = HeaderSearch(
            //     searchQuery = uiState.query,
            //     onSearchQueryChange = { viewModel.onQueryChange(it) },
            //     locationQuery = uiState.locationQuery,
            //     onLocationQueryChange = { viewModel.onLocationChange(it) },
            //     onSearchClick = { viewModel.search() }
            // ),
            // textBlock = HeaderTextBlock(
            //     overline = stringResource(R.string.{{name_snake}}_overline),
            //     title = stringResource(R.string.{{name_snake}}_hero_title)
            // ),
            // profile = HeaderProfile.Centered(
            //     initials = uiState.user?.initials ?: "?",
            //     name = uiState.user?.fullName ?: "",
            //     subtitle = uiState.user?.email,
            //     avatarSize = Dimens.avatarSizeXl
            // )
        )

        // ── Body states ──────────────────────────────────────────────────────
        when {
            uiState.isLoading -> LoadingIndicator(modifier = Modifier.fillMaxSize())
            uiState.error != null -> ErrorView(
                modifier = Modifier.fillMaxSize(),
                message = uiState.error!!,
                onRetry = { viewModel.load() }
            )
            else -> {
                LazyColumn(
                    modifier = Modifier
                        .fillMaxSize()
                        .padding(horizontal = Dimens.paddingL, vertical = Dimens.paddingM)
                ) {
                    // TODO: render list/sections.
                    // Reference: HomeScreen.kt (LazyColumn of PractitionerCards),
                    //            MyAppointmentsScreen.kt (segmented filter + list),
                    //            ProfileScreen.kt (multiple AppCard sections).
                }
            }
        }
    }
}
